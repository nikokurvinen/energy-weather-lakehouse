{
  "datasets": [
    {
      "name": "01f0887c",
      "displayName": "price_by_conditions",
      "queryLines": [
        "WITH national_weather AS (\n",
        "  SELECT time_utc, AVG(temperature_c) AS temp_avg_c\n",
        "  FROM workspace.energy_weather.fact_weather_hour\n",
        "  GROUP BY time_utc\n",
        ")\n",
        "SELECT\n",
        "  CASE\n",
        "    WHEN w.temp_avg_c <  0 THEN 'Cold (below 0)'\n",
        "    WHEN w.temp_avg_c < 15 THEN 'Mild (0 to 15)'\n",
        "    ELSE                        'Warm (above 15)'\n",
        "  END AS temperature,\n",
        "  CASE\n",
        "    WHEN p.capacity_factor < 0.15 THEN 'Calm'\n",
        "    WHEN p.capacity_factor < 0.45 THEN 'Moderate'\n",
        "    ELSE                               'Windy'\n",
        "  END AS wind_conditions,\n",
        "  ROUND(AVG(p.price_eur_mwh), 2)      AS avg_price_eur_mwh,\n",
        "  ROUND(AVG(p.price_eur_mwh) / 10, 2) AS avg_price_snt_kwh,\n",
        "  ROUND(AVG(p.consumption_mw))        AS avg_consumption_mw,\n",
        "  COUNT(*)                            AS hours\n",
        "FROM workspace.energy_weather.fact_power_hour p\n",
        "JOIN national_weather w ON p.time_utc = w.time_utc\n",
        "GROUP BY 1, 2"
      ]
    },
    {
      "name": "11fe7b0b",
      "displayName": "consumption_by_temperature",
      "queryLines": [
        "WITH national_weather AS (\n",
        "  SELECT time_utc, AVG(temperature_c) AS temp_avg_c\n",
        "  FROM workspace.energy_weather.fact_weather_hour\n",
        "  GROUP BY time_utc\n",
        ")\n",
        "SELECT\n",
        "  CASE\n",
        "    WHEN w.temp_avg_c < -20 THEN 'Below -20'\n",
        "    WHEN w.temp_avg_c < -10 THEN '-20 to -10'\n",
        "    WHEN w.temp_avg_c <   0 THEN '-10 to 0'\n",
        "    WHEN w.temp_avg_c <  10 THEN '0 to +10'\n",
        "    WHEN w.temp_avg_c <  20 THEN '+10 to +20'\n",
        "    ELSE                         'Above +20'\n",
        "  END                          AS temperature_band,\n",
        "  ROUND(AVG(p.consumption_mw)) AS avg_consumption_mw,\n",
        "  COUNT(*)                     AS hours\n",
        "FROM workspace.energy_weather.fact_power_hour p\n",
        "JOIN national_weather w ON p.time_utc = w.time_utc\n",
        "GROUP BY 1"
      ]
    },
    {
      "name": "fea743c4",
      "displayName": "wind_correlation_by_city",
      "queryLines": [
        "SELECT\n",
        "  CONCAT(a.city, ' (', a.region, ')')                AS location,\n",
        "  ROUND(CORR(w.wind_speed_ms, p.capacity_factor), 3) AS correlation\n",
        "FROM workspace.energy_weather.fact_weather_hour w\n",
        "JOIN workspace.energy_weather.fact_power_hour p ON w.time_utc = p.time_utc\n",
        "JOIN workspace.energy_weather.dim_area a ON w.area_id = a.area_id\n",
        "GROUP BY 1"
      ]
    },
    {
      "name": "ffe1ea28",
      "displayName": "monthly_variation",
      "queryLines": [
        "SELECT\n",
        "  DATE_TRUNC('MONTH', d.date) AS month,\n",
        "  ROUND(AVG(p.price_eur_mwh) / 10, 2) AS avg_price_snt_kwh,\n",
        "  ROUND(AVG(p.consumption_mw))        AS avg_consumption_mw,\n",
        "  ROUND(AVG(p.capacity_factor), 3)    AS avg_capacity_factor,\n",
        "  COUNT(*)                            AS hours\n",
        "FROM workspace.energy_weather.fact_power_hour p\n",
        "JOIN workspace.energy_weather.dim_date d\n",
        "  ON p.date_key = d.date_key\n",
        "GROUP BY 1\n",
        "ORDER BY 1"
      ]
    },
    {
      "name": "9e393a3f",
      "displayName": "headline_numbers",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*)                          AS total_hours,\n",
        "  ROUND(MAX(price_eur_mwh) / 10, 1) AS max_price_snt_kwh,\n",
        "  ROUND(AVG(capacity_factor), 3)    AS avg_capacity_factor,\n",
        "  ROUND(AVG(consumption_mw))        AS avg_consumption_mw\n",
        "FROM workspace.energy_weather.fact_power_hour"
      ]
    }
  ],
